# Local-only overrides (gitignored). The encrypted Grok key lives in .env.shared
# and is decrypted when the app starts.

# Optional plaintext override for a personal key:
# XAI_API_KEY=

# Optional: override the default model
XAI_MODEL=grok-4-fast

# Local default is SQLite (backend/crewfit.db). For Vercel + Neon:
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
# CORS_ORIGINS=https://your-app.vercel.app
