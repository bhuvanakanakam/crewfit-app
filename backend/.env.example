# Copy this file to .env and fill in your key before running the backend.

# xAI (Grok) API key — get one at https://console.x.ai
# This is the ONE place the Grok integration is wired in: see app/grok_client.py
XAI_API_KEY=

# Optional: override the default model
XAI_MODEL=grok-4-fast

# Local default is SQLite (backend/crewfit.db). For Vercel + Neon:
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
# CORS_ORIGINS=https://your-app.vercel.app

# Auth0 — same tenant + SPA client ID as the frontend VITE_AUTH0_* values.
# While AUTH0_DOMAIN is set, POST /api/auth/login requires a verified ID token.
# Locally the API also reads VITE_AUTH0_* from frontend/.env if these are empty.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# AUTH0_AUDIENCE=  # defaults to AUTH0_CLIENT_ID
