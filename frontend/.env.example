# Auth0 SPA application (Application type: Single Page Application).
# Name the Auth0 application "squadly" (Applications + Branding > Universal Login)
# so the hosted login page does not still say CrewFit / an old personal app name.
# In the Auth0 dashboard set:
#   Allowed Callback URLs:  https://localhost:5173
#   Allowed Logout URLs:    https://localhost:5173
#   Allowed Web Origins:    https://localhost:5173
#   Allowed Origins (CORS): https://localhost:5173
# Token Endpoint Authentication Method should be None.

VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id

# The API must use the same tenant + client ID (AUTH0_DOMAIN / AUTH0_CLIENT_ID)
# so it can verify the Auth0 ID token. Name-only login is disabled.

# Production: the FastAPI origin (Railway/Render/Fly), not Vercel itself.
# Vercel hosts the React app; the API needs a persistent process + DATABASE_URL.
# VITE_API_BASE=https://your-api.example.com
