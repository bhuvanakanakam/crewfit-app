# Auth0 SPA application (Application type: Single Page Application).
# In the Auth0 dashboard set:
#   Allowed Callback URLs:  https://localhost:5173
#   Allowed Logout URLs:    https://localhost:5173
#   Allowed Web Origins:    https://localhost:5173
#   Allowed Origins (CORS): https://localhost:5173
# Token Endpoint Authentication Method should be None.

VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
